<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/JDialog_container">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/white_radius_10_bg"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- 内容 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/contentTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_5"
                android:layout_marginBottom="15dp"
                android:gravity="center_horizontal"
                android:text="@string/password_title"
                android:textColor="@color/grey01"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.xcore.ui.widget.view.VerificationCodeView
                android:id="@+id/vc_author"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_15"
                android:layout_marginBottom="@dimen/dimen_15" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_15"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cancelBtn"
                android:layout_width="0dp"
                android:layout_height="@dimen/dimen_45"
                android:layout_marginRight="10dp"
                android:layout_weight="1"
                android:background="@drawable/btn_cancel_selector"
                android:gravity="center"
                android:text="@string/cancel"
                android:textColor="@color/cancel_text_color"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/okBtn"
                android:layout_width="0dp"
                android:layout_height="@dimen/dimen_45"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:background="@drawable/btn_confirm_selector"
                android:gravity="center"
                android:text="@string/confirm"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
