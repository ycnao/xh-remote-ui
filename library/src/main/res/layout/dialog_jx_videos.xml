<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/JDialog_container">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/white_radius_10_bg"
        android:orientation="vertical"
        android:padding="15dp">

        <!-- 内容 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="15dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/contentTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                android:gravity="center_horizontal"
                android:text="@string/video_address"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/edit_name"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:background="@drawable/input_radius_bg"
                android:hint="@string/please_input_name"
                android:maxLines="1"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:textColor="@color/grey01"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/edit_content"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginTop="@dimen/dimen_10"
                android:background="@drawable/input_radius_bg"
                android:gravity="top|left"
                android:hint="@string/please_input_rtsp"
                android:padding="10dp"
                android:textColor="@color/grey01"
                android:textSize="13sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/cancelBtn"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_margin="@dimen/dimen_5"
                android:layout_weight="1"
                android:background="@drawable/btn_cancel_selector"
                android:elevation="3dp"
                android:text="@string/cancel"
                android:textColor="@color/cancel_text_color"
                android:textSize="14sp" />

            <Button
                android:id="@+id/okBtn"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_margin="@dimen/dimen_5"
                android:layout_weight="1"
                android:background="@drawable/btn_confirm_selector"
                android:elevation="3dp"
                android:text="@string/confirm"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
