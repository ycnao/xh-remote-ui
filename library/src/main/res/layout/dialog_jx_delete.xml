<!-- custom_dialog.xml -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/black_radius_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/dimen_15">

        <!-- 弹窗内容 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/dialog_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/delete"
                android:textAppearance="@style/TextAppearance.AppCompat.Title"
                android:textColor="@color/white"
                android:textSize="@dimen/size_16sp" />

            <ImageView
                android:id="@+id/dialog_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right"
                android:src="@mipmap/ic_close" />

        </FrameLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dimen_16"
            android:layout_marginTop="@dimen/dimen_28"
            android:layout_marginRight="@dimen/dimen_16"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/dialog_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:text="@string/please_confirm_delete"
                android:textColor="@color/white"
                android:textSize="@dimen/size_14sp" />


        </LinearLayout>

        <!-- 按钮 -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dimen_40"
            android:layout_marginTop="@dimen/dimen_40"
            android:layout_marginRight="@dimen/dimen_40"
            android:layout_marginBottom="@dimen/dimen_10"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/dialog_cancel_btn"
                android:layout_width="@dimen/dimen_85"
                android:layout_height="@dimen/dimen_30"
                android:background="@drawable/btn_grey_radius_selector"
                android:gravity="center"
                android:text="@string/cancel"
                android:textColor="@color/white"
                android:textSize="@dimen/size_14sp" />

            <TextView
                android:id="@+id/dialog_confirm_btn"
                android:layout_width="@dimen/dimen_85"
                android:layout_height="@dimen/dimen_30"
                android:layout_marginStart="@dimen/dimen_20"
                android:background="@drawable/btn_red_radius_selector"
                android:gravity="center"
                android:text="@string/confirm"
                android:textColor="@color/white"
                android:textSize="@dimen/size_14sp" />

        </LinearLayout>
    </LinearLayout>
</FrameLayout>